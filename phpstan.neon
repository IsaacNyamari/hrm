includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Larastan's model relation/property types are heuristic (e.g. a belongsTo
    # on a soft-deletable model can still be null). Don't treat those PHPDoc
    # types as certain.
    treatPhpDocTypesAsCertain: false
