APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Multi-tenancy: hosts that are NOT tenant subdomains (marketing site, /platform,
# /register). A subdomain of one of these (e.g. abc-company.hrm.test) resolves a
# tenant by slug when TENANCY_SUBDOMAINS_ENABLED is true.
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1
TENANCY_SUBDOMAINS_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# HRM application configuration
# ---------------------------------------------------------------------------

# Passkey (WebAuthn) user-handle HMAC secret. Generate a random 32+ char string.
PASSKEYS_USER_HANDLE_SECRET=

# Sanctum: SPA hosts allowed to use cookie auth (leave blank for token-only API).
SANCTUM_STATEFUL_DOMAINS=

# Platform Super Admin created by PlatformSeeder (set real values in production)
PLATFORM_ADMIN_NAME="Platform Super Admin"
PLATFORM_ADMIN_EMAIL=superadmin@hrm.test
PLATFORM_ADMIN_PASSWORD=password

# Billing defaults
BILLING_CURRENCY=KES
# Fallback gateway until a platform admin picks one under Platform > Settings.
BILLING_DEFAULT_PROVIDER=paystack
BILLING_GRACE_DAYS=7
BILLING_INVOICE_PREFIX=INV
BILLING_TAX_RATE=0

# Paystack. Webhook URL to set in the Paystack dashboard:
# https://<your-domain>/api/webhooks/paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=

# Safaricom Daraja (M-Pesa STK push). Needed only if a platform admin makes M-Pesa the active gateway.
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=

# Attendance
ATTENDANCE_GEOFENCE_REQUIRED=false
ATTENDANCE_GEOFENCE_RADIUS=200
ATTENDANCE_AUTO_CLOCKOUT_HOURS=16

# ZKTeco biometric devices (ADMS push protocol)
# Point each terminal's ADMS/Cloud server address at:
#   http://<this-app's-domain>/iclock  (no per-tenant subdomain — devices are
#   matched to a company by serial number, registered from the Attendance page)
ZKTECO_ROUTE_PREFIX=iclock
ZKTECO_ROUTE_DOMAIN=
ZKTECO_OFFLINE_THRESHOLD=10
ZKTECO_DEFAULT_TIMEZONE=UTC

# Leave / expenses
LEAVE_YEAR_START_MONTH=1
EXPENSE_MILEAGE_RATE_CENTS=6000

# ---------------------------------------------------------------------------
# Production overrides (see docs/deployment.md)
# ---------------------------------------------------------------------------
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://app.yourdomain.com
#   TENANCY_CENTRAL_DOMAINS=yourdomain.com,app.yourdomain.com
#   LOG_LEVEL=warning  LOG_STACK=daily
#   DB_CONNECTION=mysql   (MySQL 8+)
#   SESSION_DRIVER=redis  CACHE_STORE=redis  QUEUE_CONNECTION=redis
#   SESSION_SECURE_COOKIE=true  SESSION_SAME_SITE=lax
#   FILESYSTEM_DISK=local   (private employee documents stay off S3 unless the bucket is private)
#   MAIL_MAILER=smtp / postmark / resend / ses

# Laravel Reverb (real-time broadcasting). Generate app id/key/secret with
# `php artisan reverb:install` or any random strings. REVERB_HOST/PORT/SCHEME
# are what browsers connect to (behind nginx: your domain, 443, https);
# REVERB_SERVER_HOST/PORT are where the Reverb process itself listens.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
